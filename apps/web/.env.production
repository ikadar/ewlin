# API Configuration (Production)
# In production, we use the real API
VITE_USE_MOCK=false

# Backend API URL — leave commented to fall back to same-origin relative path /api/v1
# Set explicitly only when FE and API live on different hosts (e.g. CDN-fronted FE).
# VITE_API_URL=https://api.example.com/api/v1

# Mercure Hub URL for real-time SSE updates — same: leave commented to fall back to /.well-known/mercure
# VITE_MERCURE_URL=https://mercure.example.com/.well-known/mercure
