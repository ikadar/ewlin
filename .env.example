# ===========================================
# Flux Print Shop Scheduling System
# Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# NEVER commit .env to version control!

# ===========================================
# MariaDB Configuration
# ===========================================
MARIADB_ROOT_PASSWORD=flux_root_secret_change_me
MARIADB_DATABASE=flux_scheduler
MARIADB_USER=flux_user
MARIADB_PASSWORD=flux_password_change_me
MARIADB_PORT=3306

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PORT=6379

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=8080

# ===========================================
# Validation Service Configuration
# ===========================================
VALIDATION_SERVICE_PORT=3001

# ===========================================
# Mercure Configuration
# ===========================================
MERCURE_PORT=3000
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# ===========================================
# Symfony Application
# ===========================================
# dev | test | prod
APP_ENV=dev
APP_SECRET=change_me_in_production_use_random_string

# ===========================================
# Console-service (NL ALT+I + MCP)
# ===========================================
# Provider family: 'anthropic' (default, Claude Haiku 4.5) or
# 'openai-compat' (any OpenAI-compatible endpoint — Groq, OpenRouter,
# Together, Fireworks, Cerebras, …).
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX
LLM_MODEL=claude-haiku-4-5-20251001

# Required when LLM_PROVIDER=openai-compat. The host is selected by
# BASE_URL; switch hosts by changing it + API_KEY together.
# Examples:
#   Groq direct:  https://api.groq.com/openai/v1   (key: gsk_...)
#   OpenRouter:   https://openrouter.ai/api/v1     (key: sk-or-v1-...)
#   Together:     https://api.together.xyz/v1      (key: tgp-...)
#   Cerebras:     https://api.cerebras.ai/v1       (key: csk-...)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-20b
# OpenRouter-only: when true and base URL points to OpenRouter, the model
# id is suffixed with `:nitro`, asking OpenRouter to sort providers by
# throughput (highest tokens/sec first). Equivalent to provider.sort =
# "throughput" in the request body. No-op for Groq/Together/Cerebras.
# OPENAI_COMPAT_NITRO=false
# Optional output budget per LLM turn. Reasoning models (GPT OSS, o1)
# emit reasoning_tokens that count toward this limit.
# Defaults: 512 for anthropic, 2048 for openai-compat.
# LLM_MAX_TOKENS_PER_TURN=
