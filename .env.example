# ===========================================
# Flux Print Shop Scheduling System
# Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# NEVER commit .env to version control!

# ===========================================
# MariaDB Configuration
# ===========================================
MARIADB_ROOT_PASSWORD=flux_root_secret_change_me
MARIADB_DATABASE=flux_scheduler
MARIADB_USER=flux_user
MARIADB_PASSWORD=flux_password_change_me
MARIADB_PORT=3306

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PORT=6379

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=8080

# ===========================================
# Validation Service Configuration
# ===========================================
VALIDATION_SERVICE_PORT=3001

# ===========================================
# Mercure Configuration
# ===========================================
MERCURE_PORT=3000
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# ===========================================
# Symfony Application
# ===========================================
# dev | test | prod
APP_ENV=dev
APP_SECRET=change_me_in_production_use_random_string

# ===========================================
# Console-service (NL ALT+I + MCP)
# ===========================================
# Provider switch: 'anthropic' (default, Claude Haiku 4.5) or 'groq'
# (OpenAI-compatible endpoint, GPT OSS 20B by default).
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX
LLM_MODEL=claude-haiku-4-5-20251001

# Required when LLM_PROVIDER=groq.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXX
GROQ_MODEL=openai/gpt-oss-20b
# Optional override; default is https://api.groq.com/openai/v1
# GROQ_BASE_URL=
# Optional output budget per LLM turn. Reasoning models (GPT OSS) need
# more headroom because reasoning_tokens count toward this limit.
# Defaults: 512 for anthropic, 2048 for groq.
# LLM_MAX_TOKENS_PER_TURN=
