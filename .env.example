# ===========================================
# Flux Print Shop Scheduling System
# Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# NEVER commit .env to version control!

# ===========================================
# MariaDB Configuration
# ===========================================
MARIADB_ROOT_PASSWORD=flux_root_secret_change_me
MARIADB_DATABASE=flux_scheduler
MARIADB_USER=flux_user
MARIADB_PASSWORD=flux_password_change_me
MARIADB_PORT=3306

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PORT=6379

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=8080

# ===========================================
# Validation Service Configuration
# ===========================================
VALIDATION_SERVICE_PORT=3001

# ===========================================
# Mercure Configuration
# ===========================================
MERCURE_PORT=3000
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# ===========================================
# Symfony Application
# ===========================================
# dev | test | prod
APP_ENV=dev
APP_SECRET=change_me_in_production_use_random_string

# ===========================================
# Console-service (NL ALT+I + MCP)
# ===========================================
# Required: Anthropic API key for Claude Haiku that drives the NL console.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX
LLM_MODEL=claude-haiku-4-5-20251001
