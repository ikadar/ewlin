{
  "name": "@flux/console-service",
  "version": "0.1.0",
  "description": "Natural language console + MCP server for Flux scheduler",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:http": "node dist/main.js http",
    "start:mcp-stdio": "node dist/main.js mcp-stdio",
    "dev": "tsx watch src/main.ts http",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
